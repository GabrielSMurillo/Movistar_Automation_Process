# Environment Variables - Movistar Automation System
# Copiar este archivo a .env y configurar los valores

# ============================================================================
# GENERAL CONFIGURATION
# ============================================================================
MOVISTAR_ENV=development
MOVISTAR_DEBUG=true

# ============================================================================
# PROCESSING DATES
# ============================================================================
# Dejar vacío para usar valores por defecto (mes actual)
MOVISTAR_START_DATE=2025-10-01
MOVISTAR_END_DATE=2025-10-31

# ============================================================================
# PATHS (opcional - usar defaults si está vacío)
# ============================================================================
# MOVISTAR_BASE_DIR=/path/to/project
# MOVISTAR_DATA_DIR=/path/to/data
# MOVISTAR_INPUT_DIR=/path/to/input
# MOVISTAR_OUTPUT_DIR=/path/to/output

# ============================================================================
# PERFORMANCE SETTINGS
# ============================================================================
MOVISTAR_MAX_WORKERS=4
MOVISTAR_CHUNK_SIZE=10000
MOVISTAR_ENABLE_CACHE=true
MOVISTAR_CACHE_TTL=3600

# ============================================================================
# QUALITY THRESHOLDS
# ============================================================================
MOVISTAR_MAX_NULL_RATE=0.30
MOVISTAR_MAX_DUPLICATE_RATE=0.15
MOVISTAR_MIN_PHONE_LENGTH=7
MOVISTAR_MAX_PHONE_LENGTH=10

# ============================================================================
# LOGGING
# ============================================================================
MOVISTAR_LOG_LEVEL=INFO
MOVISTAR_LOG_TO_FILE=true
MOVISTAR_LOG_ROTATION_SIZE=10485760
MOVISTAR_LOG_BACKUP_COUNT=5

# ============================================================================
# DATABASE (futuro)
# ============================================================================
# MOVISTAR_DB_URL=postgresql://user:password@localhost:5432/movistar
# MOVISTAR_DB_POOL_SIZE=5

# ============================================================================
# INTEGRATIONS (futuro)
# ============================================================================
# MOVISTAR_EMAIL_HOST=smtp.gmail.com
# MOVISTAR_EMAIL_PORT=587
# MOVISTAR_EMAIL_USER=notifications@company.com
# MOVISTAR_EMAIL_PASSWORD=xxxxx
# MOVISTAR_EMAIL_TO=admin@company.com

# ============================================================================
# FEATURE FLAGS
# ============================================================================
MOVISTAR_ENABLE_PARALLEL_PROCESSING=false
MOVISTAR_ENABLE_NOTIFICATIONS=false
MOVISTAR_ENABLE_AUTO_BACKUP=true
